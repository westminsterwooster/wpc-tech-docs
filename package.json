{
  "name": "wpc-tech-docs",
  "version": "2026.05a",
  "private": true,
  "description": "Westminster Presbyterian Church insider technology documentation.",
  "scripts": {
    "start": "docusaurus start",
    "build": "npm run build:site && npm run pdf:build && npm run build:site",
    "build:site": "npm run docs:check-links && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "pdf:build": "node scripts/build-pdf.mjs",
    "pdf:install-browser": "node scripts/install-pdf-browser.mjs",
    "typecheck": "tsc --noEmit",
    "build:all": "npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.1",
    "docusaurus-docs-to-pdf": "^0.0.5",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "brace-expansion": "1.1.18",
    "fast-uri": "3.1.5",
    "http-proxy-middleware": "2.0.10",
    "joi": "17.13.4",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "serialize-javascript": "7.0.5",
    "undici": "7.29.0",
    "uuid": "11.1.1",
    "webpack-dev-server": "6.0.0"
  },
  "engines": {
    "node": ">=20.0"
  }
